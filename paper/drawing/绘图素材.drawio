        <mxCell id="urMcuPGL8E_EOTHFhdqJ-79" value="\[S(k,m)=X_m[k]\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="880" y="1618" width="120" height="30" as="geometry" />
