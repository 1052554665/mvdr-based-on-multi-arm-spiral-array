        <mxCell id="urMcuPGL8E_EOTHFhdqJ-82" value="\[\mathbf{R}_{xx}(f) = \frac{1}{M} \sum_{m=1}^{M} \mathbf{X}_f(m) \mathbf{X}_f(m)^H\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="100" y="1541.5" width="480" height="30" as="geometry" />
