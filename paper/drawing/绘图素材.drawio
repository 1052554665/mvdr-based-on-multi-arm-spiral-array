        <mxCell id="urMcuPGL8E_EOTHFhdqJ-83" value="\[\mathbf{w}_{MVDR}(f) = \frac{\mathbf{R}_{xx}^{-1}(f) \mathbf{a}(f)}{\mathbf{a}^H(f) \mathbf{R}_{xx}^{-1}(f) \mathbf{a}(f)}\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
