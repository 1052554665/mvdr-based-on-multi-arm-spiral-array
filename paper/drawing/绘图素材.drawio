        <mxCell id="urMcuPGL8E_EOTHFhdqJ-80" value="\[P(k,m) = 10\log_{10}\left(|S(k,m)|^2\right)\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
