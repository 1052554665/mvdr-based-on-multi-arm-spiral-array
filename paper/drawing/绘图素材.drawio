        <mxCell id="urMcuPGL8E_EOTHFhdqJ-81" value="\[a_m(f_k) = e^{-j 2\pi f_k \frac{r_m \cdot d_{\text{target}}}{c}}\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
