        <mxCell id="urMcuPGL8E_EOTHFhdqJ-77" value="$$x_\omega[n]=x[n+mR]\cdot\omega[n]$$" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="835" y="1461.5" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="urMcuPGL8E_EOTHFhdqJ-78" value="\[X_m[k]=\sum_{n=0}^{N-1} x_w[n] e^{-j 2\pi k n / N}\]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="820" y="1541.5" width="300" height="30" as="geometry" />
